{
  "id": "cloud-relay",
  "kind": "channel",
  "channels": ["cloud-relay"],
  "name": "Cloud Relay Tunnel",
  "description": "Browser chat sessions via Cloud Relay tunnel",
  "channelEnvVars": {
    "cloud-relay": ["CLOUD_RELAY_TOKEN"]
  },
  "contracts": {
    "tools": ["get_user_location"]
  },
  "toolMetadata": {
    "get_user_location": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "token": { "type": "string" }
    }
  },
  "channelConfigs": {
    "cloud-relay": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string" },
          "relayUrl": { "type": "string" }
        }
      },
      "uiHints": {
        "token": {
          "label": "Relay token",
          "sensitive": true
        },
        "relayUrl": {
          "label": "Relay URL",
          "placeholder": "wss://ocv.razer.ai/_tunnel"
        }
      }
    }
  }
}
